{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"]
  },
  "exclude": [
    "dist",
    "node_modules",
    "nuxt.config.ts",
    "playground",
    "test/fixtures"
  ]
}

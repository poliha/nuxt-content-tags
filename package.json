{
  "name": "nuxt-content-tags",
  "version": "0.1.1",
  "description": "Zero-config WordPress-like tagging module for Nuxt Content",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poliha/nuxt-content-tags.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "main": "./dist/module.cjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxi prepare . && nuxi prepare playground",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": ">=3.13.0",
    "confbox": "^0.2.4"
  },
  "devDependencies": {
    "@nuxt/content": "^3.6.1",
    "@nuxt/devtools": "^1.5.0",
    "@nuxt/eslint-config": "^0.5.7",
    "@nuxt/module-builder": "^1.0.0",
    "@nuxt/schema": "^3.13.0",
    "@nuxt/test-utils": "^3.14.0",
    "@nuxt/ui": "^4.10.0",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.6.2",
    "changelogen": "^0.5.5",
    "eslint": "^9.37.0",
    "nuxt": "^4.5.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.1.0"
  },
  "peerDependencies": {
    "@nuxt/content": ">=3.6.0",
    "@nuxt/ui": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/ui": {
      "optional": true
    }
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "nuxt-content",
    "tags",
    "tagging",
    "wordpress",
    "content",
    "seo"
  ],
  "author": {
    "name": "Peter Oliha",
    "url": "https://oliha.dev"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
